{
  "name": "momora",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --android --dev-client",
    "ios": "expo start --ios --dev-client",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "db:reset": "supabase db reset --local",
    "test:db": "supabase test db --local supabase/tests",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:edge": "deno test --allow-env --allow-net --allow-ffi --allow-read=supabase/functions,supabase/scripts,src/utils --node-modules-dir=none supabase/functions/ supabase/scripts/",
    "eval:portrait": "npx --yes deno run --allow-all --env-file=supabase/.env.local --env-file=.env.local supabase/scripts/eval-portrait.ts",
    "eval:illustration": "npx --yes deno run --allow-all --env-file=supabase/.env.local --env-file=.env.local supabase/scripts/eval-illustration.ts",
    "eval:image-cost": "npx --yes deno run --allow-all --env-file=supabase/.env.local --env-file=.env.local supabase/scripts/eval-image-cost.ts",
    "seed:demo-top-up": "npx --yes deno run --allow-all --env-file=supabase/.env.local --env-file=.env.local supabase/scripts/seed-demo-top-up.ts",
    "art:onboarding": "npx --yes deno run --allow-all --env-file=supabase/.env.local --env-file=.env.local supabase/scripts/generate-onboarding-art.ts",
    "export:onboarding": "npx --yes deno run --allow-all --env-file=supabase/.env.local --env-file=.env.local supabase/scripts/export-onboarding-memories.ts",
    "export:onboarding-portraits": "npx --yes deno run --allow-all --node-modules-dir=none --env-file=supabase/.env.local --env-file=.env.local supabase/scripts/export-onboarding-portrait-pairs.ts",
    "regenerate:illustrations": "npx --yes deno run --allow-all --env-file=supabase/.env.local --env-file=.env.local supabase/scripts/regenerate-illustrations.ts",
    "backfill:previews": "npx --yes deno run --allow-all --node-modules-dir=none --env-file=supabase/.env.local --env-file=.env.local supabase/scripts/backfill-media-previews.ts",
    "backfill:video-posters": "npx --yes deno run --allow-all --node-modules-dir=none --env-file=supabase/.env.local --env-file=.env.local supabase/scripts/backfill-video-posters.ts",
    "backfill:share-cards": "npx --yes deno run --allow-all --node-modules-dir=none --env-file=supabase/.env.local --env-file=.env.local supabase/scripts/backfill-share-cards.ts",
    "backfill:portrait-reencode": "npx --yes deno run --allow-all --node-modules-dir=none --env-file=supabase/.env.local --env-file=.env.local supabase/scripts/backfill-portrait-reencode.ts",
    "test:e2e:family-fixture": "maestro test .maestro/flows/onboarding/add-family-member-with-fixture.yaml",
    "test:e2e:family-picker": "maestro test .maestro/flows/onboarding/add-family-member-with-picker.yaml",
    "test:e2e:onboarding": "bash supabase/scripts/run-onboarding-maestro.sh",
    "test:e2e:onboarding:owner-visual-audit": "bash supabase/scripts/run-onboarding-visual-audit.sh",
    "test:e2e:onboarding:owner-visual-audit:pre-auth": "bash supabase/scripts/run-onboarding-visual-audit-pre-auth.sh",
    "test:e2e:onboarding:fixture": "deno run --allow-env --allow-net supabase/scripts/onboarding-maestro-fixture.ts",
    "test:e2e:usage-limits:seed": "deno run --allow-env --allow-net supabase/scripts/usage-limits-e2e-fixture.ts",
    "test:e2e:usage-limits:clean": "deno run --allow-env --allow-net supabase/scripts/usage-limits-e2e-fixture.ts --cleanup",
    "test:e2e:usage-limits": "npm run test:e2e:usage-limits:seed && (maestro test .maestro/flows/usage-limits/memory-limit.yaml; status=$?; npm run test:e2e:usage-limits:clean; exit $status)"
  },
  "dependencies": {
    "@expo-google-fonts/caveat": "^0.4.2",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.107.0",
    "@tanstack/query-async-storage-persister": "5.100.14",
    "@tanstack/react-query": "^5.90.11",
    "@tanstack/react-query-persist-client": "5.100.14",
    "@types/ws": "^8.18.1",
    "expo": "~56.0.16",
    "expo-application": "~56.0.3",
    "expo-asset": "~56.0.19",
    "expo-audio": "~56.0.12",
    "expo-auth-session": "~56.0.15",
    "expo-constants": "~56.0.15",
    "expo-dev-client": "~56.0.23",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.7",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-image-manipulator": "~56.0.22",
    "expo-image-picker": "~56.0.21",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.15",
    "expo-localization": "~56.0.6",
    "expo-notifications": "~56.0.21",
    "expo-router": "~56.2.15",
    "expo-sharing": "~56.0.22",
    "expo-splash-screen": "~56.0.13",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-updates": "~56.0.22",
    "expo-video": "~56.1.4",
    "expo-video-thumbnails": "^56.0.3",
    "expo-web-browser": "~56.0.5",
    "lucide-react-native": "^1.24.0",
    "posthog-react-native": "^4.61.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-compressor": "^1.16.0",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-keyboard-controller": "1.21.6",
    "react-native-purchases": "10.6.0",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "react-test-renderer": "19.2.3",
    "supabase": "2.110.0",
    "typescript": "~6.0.3"
  }
}
