# Dependencies
node_modules/

# --- Secrets & environment (NEVER COMMIT) ---
.env
.env.*
!.env.example
*.env.local
supabase/.env
supabase/.env.*
!supabase/.env.example

# API keys and credentials
**/secrets/
*.pem
*.key
*.p8
*.p12
*.jks
*.keystore
*.mobileprovision
*.cer
*.crt
credentials.json
service-account*.json

# Firebase / Google (if added later — often contain API keys)
google-services.json
GoogleService-Info.plist

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native (generated locally; may contain signing config)
/ios/
/android/

# OS
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE
.idea/
.vscode/settings.json.local

# Supabase local
supabase/.temp/
supabase/.branches/

# TypeScript
*.tsbuildinfo

# Testing
coverage/
.env.test.local
.maestro/report/
.maestro/.env.local

# EAS
.eas/
eas-build-*.json

# Logs (may accidentally contain tokens)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.turbo/
.cache/
*.orig
supabase/functions/deno.lock
supabase/scripts/eval-output/

# Memory Book V3 asset export -- family content, own-account only, never committed.
# The fabricated sample/ book (placeholder SVGs, no real memories) IS tracked --
# it's the zero-real-data fixture the book-renderer preview + vitest tests need.
book-renderer/book-data/*
!book-renderer/book-data/sample/
!book-renderer/book-data/sample/**

# Claude Code local settings
.claude/settings.local.json

# Marketing assets are local-only (GBs of media; never pushed)
marketing/

# Store listing renders / generated images (kept locally, not in git)
store-assets/v2/**/*.png
store-assets/archive/**/*.png
store-assets/preview/
momora-listing-handoff-v2/**/*.png
book-renderer/book-data/sample/print/
