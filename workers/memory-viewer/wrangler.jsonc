{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "momora-memory-viewer",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "SUPABASE_URL": "https://uglhonlaqkqvxcqudwlk.supabase.co"
  },
  "secrets": {
    "required": ["SUPABASE_SERVICE_ROLE_KEY"]
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "momora-prod"
    }
  ],
  // Custom domain for the QR viewer (docs/plans/memory-book.md §7/§8).
  // Owner decision (Round-19): m.usemomora.com -- a subdomain of the app's
  // EXISTING usemomora.com, matching every other public-facing Momora link
  // (see app.json's applinks:usemomora.com, docs/features/family-sharing.md),
  // not the earlier placeholder momora.app. See the README's "DNS" section
  // for the one record the owner adds before this route can go live.
  "routes": [
    {
      "pattern": "m.usemomora.com",
      "custom_domain": true
    }
  ],
  "env": {
    "staging": {
      "name": "momora-memory-viewer-staging",
      "vars": {
        "SUPABASE_URL": "https://REPLACE_WITH_STAGING_PROJECT_REF.supabase.co"
      },
      "secrets": {
        "required": ["SUPABASE_SERVICE_ROLE_KEY"]
      },
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "REPLACE_WITH_STAGING_MEDIA_BUCKET"
        }
      ]
    }
  }
}
