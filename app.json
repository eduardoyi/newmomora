{
  "expo": {
    "name": "Momora",
    "slug": "momora",
    "version": "1.4.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "momora",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.memora.app",
      "associatedDomains": [
        "applinks:usemomora.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ],
        "com.apple.security.application-groups": [
          "group.com.memora.app.shared",
          "group.com.memora.app.widgets"
        ]
      }
    },
    "android": {
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F5EFE6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.memora.app",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "usemomora.com",
              "pathPrefix": "/invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidAllowBackup",
      "./plugins/withAndroidLaunchMode",
      "./plugins/withMomoraWidget",
      "expo-background-task",
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "shortcut_compose": { "foregroundImage": "./assets/images/shortcuts/shortcut-compose.png", "monochromeImage": "./assets/images/shortcuts/shortcut-compose.png", "backgroundColor": "#FFFFFF" },
            "shortcut_camera": { "foregroundImage": "./assets/images/shortcuts/shortcut-camera.png", "monochromeImage": "./assets/images/shortcuts/shortcut-camera.png", "backgroundColor": "#FFFFFF" },
            "shortcut_mic": { "foregroundImage": "./assets/images/shortcuts/shortcut-mic.png", "monochromeImage": "./assets/images/shortcuts/shortcut-mic.png", "backgroundColor": "#FFFFFF" },
            "shortcut_scan": { "foregroundImage": "./assets/images/shortcuts/shortcut-scan.png", "monochromeImage": "./assets/images/shortcuts/shortcut-scan.png", "backgroundColor": "#FFFFFF" }
          }
        }
      ],
      "expo-router",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.memora.app.widgets",
          "widgets": [
            {
              "name": "MomoraMemoryWidget",
              "displayName": "Momora",
              "description": "A memory from your family journal",
              "ios": {
                "supportedFamilies": [
                  "systemSmall"
                ],
                "contentMarginsDisabled": true
              }
            }
          ],
          "enableAndroid": false,
          "bundleIdentifier": "com.memora.app.ExpoWidgetsTarget"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5EFE6"
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Momora uses your photo library to add photos and videos to family memories, privately suggest moments for your review, and choose profile photos for family members.",
          "cameraPermission": "Momora uses your camera to take photos for family memories and family member profiles, and to scan your children's artwork."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Momora uses your photo library to privately suggest family memories from photos you choose to let it review.",
          "granularPermissions": [
            "photo"
          ],
          "isAccessMediaLocationEnabled": false,
          "preventAutomaticLimitedAccessAlert": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Momora uses your microphone to record voice memories, which are transcribed into journal entries.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#D63E78"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-video",
      "expo-asset",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "appGroupId": "group.com.memora.app.shared",
            "activationRule": "(SUBQUERY(extensionItems, $e, $e.attachments.@count >= 1 AND $e.attachments.@count <= 10 AND SUBQUERY($e.attachments, $a, (ANY $a.registeredTypeIdentifiers UTI-CONFORMS-TO \"public.image\") OR (ANY $a.registeredTypeIdentifiers UTI-CONFORMS-TO \"public.movie\")).@count == $e.attachments.@count).@count == extensionItems.@count AND extensionItems.@count >= 1) OR (extensionItems.@count == 1 AND SUBQUERY(extensionItems, $e, $e.attachments.@count == 1 AND SUBQUERY($e.attachments, $a, (ANY $a.registeredTypeIdentifiers UTI-CONFORMS-TO \"public.audio\") OR (ANY $a.registeredTypeIdentifiers UTI-CONFORMS-TO \"public.mpeg-4-audio\") OR (ANY $a.registeredTypeIdentifiers UTI-CONFORMS-TO \"org.xiph.ogg\") OR (ANY $a.registeredTypeIdentifiers UTI-CONFORMS-TO \"org.xiph.opus\") OR (ANY $a.registeredTypeIdentifiers UTI-CONFORMS-TO \"org.xiph.ogg-audio\")).@count == 1).@count == 1)"
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "image/*",
              "video/*",
              "audio/*",
              "application/ogg"
            ],
            "multipleShareMimeTypes": [
              "image/*",
              "video/*"
            ]
          }
        }
      ],
      "expo-localization",
      "expo-web-browser",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "momora",
          "project": "momora-app"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6e6727aa-fe88-482c-ad1b-6e108b235f54"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6e6727aa-fe88-482c-ad1b-6e108b235f54"
    }
  }
}
