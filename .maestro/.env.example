# Maestro e2e credentials (gitignored)
# Copy to .env.local and fill with a real Supabase test account
TEST_EMAIL=
TEST_PASSWORD=
REPORT_MEMORY_ID=

# Run with:
# maestro test -e TEST_EMAIL=you@example.com -e TEST_PASSWORD=secret .maestro/flows/

# Family profile upload flows (dev client only):
# CI / reliable upload path (bundled E2E fixture photo):
# maestro test -e TEST_EMAIL=... -e TEST_PASSWORD=... .maestro/flows/onboarding/add-family-member-with-fixture.yaml
#
# Real system photo picker (optional / pre-release):
# maestro test -e TEST_EMAIL=... -e TEST_PASSWORD=... .maestro/flows/onboarding/add-family-member-with-picker.yaml

# Full owner + invitee onboarding E2E is intentionally local-only. It creates
# fresh synthetic @example.test accounts, reads the real OTP from local
# Mailpit, and removes the fixture in a shell trap:
# SUPABASE_URL=http://127.0.0.1:54321 \
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321 \
# SUPABASE_SERVICE_ROLE_KEY=local-service-role-key \
# MAILPIT_URL=http://127.0.0.1:54324 \
# R2_ENDPOINT=http://127.0.0.1:9000 \
# CLOUDFLARE_ILLUSTRATION_WORKFLOW_URL=http://127.0.0.1:8787/dispatch/memory \
# CLOUDFLARE_PORTRAIT_WORKFLOW_URL=http://127.0.0.1:8787/dispatch/portrait \
# MEMORY_ILLUSTRATION_BACKEND=cloudflare \
# PORTRAIT_GENERATION_BACKEND=cloudflare \
# CRON_SECRET=<local-cron-secret> \
# ONBOARDING_E2E_IMAGE_STACK=isolated-local \
# MAESTRO_DEVICE_ID=<the one simulator/device id> \
# npm run test:e2e:onboarding
#
# The running development client, Supabase Edge Functions (including
# hard-delete-expired-accounts), Worker, and R2-compatible object store must
# all be configured for the same isolated local stack. The runner waits for a
# rendered portrait and cleans the synthetic owner through the normal
# deletion-fence/R2 cleanup path. Do not run this against a hosted Supabase
# project or with production R2/OpenAI worker settings. It reads `.env.local`
# to verify EXPO_PUBLIC_SUPABASE_URL and `supabase/.env.local` to verify the
# Worker/R2 endpoints, plus the Worker's `.dev.vars` reverse bridge URLs,
# without printing any values. Restart Metro after changing `.env.local`,
# start `supabase functions serve` with that exact `supabase/.env.local` file,
# and run the Worker with `wrangler dev --local` (never `--remote`).
