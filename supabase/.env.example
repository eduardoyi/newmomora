# Supabase Edge Functions — add to supabase/.env.local (gitignored)
# Production: supabase secrets set KEY=value

OPENAI_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Safe operator address for metadata-only content-report alerts. Defaults to
# hello@usemomora.com when unset.
CONTENT_REPORT_ALERT_EMAIL=hello@usemomora.com

# Cloudflare R2 (S3-compatible) — images only; NOT in client
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=momora-prod
R2_PUBLIC_ASSETS_BASE_URL=https://assets.yourdomain.com

# Gallery-import Workflow dispatch and narrow HMAC bridge. These values must
# match the Worker secret store; do not place either in Expo/EAS public env.
GALLERY_WORKER_URL=https://momora-gallery-import.example.workers.dev
GALLERY_DISPATCH_SIGNING_SECRET=
CLOUDFLARE_GALLERY_BRIDGE_SECRET=
