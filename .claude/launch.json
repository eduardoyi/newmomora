{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "book-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "book-renderer",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "book-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "dev",
        "--config",
        "vite.web.config.ts",
        "--port",
        "5199"
      ],
      "cwd": "book-renderer",
      "port": 5199
    },
    {
      "name": "film-storyboards",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5188",
        "--bind",
        "127.0.0.1",
        "--directory",
        "supabase/scripts/eval-output/year-film-script"
      ],
      "port": 5188
    },
    {
      "name": "film-sheet",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5189",
        "--bind",
        "127.0.0.1",
        "--directory",
        "film-renderer"
      ],
      "port": 5189
    }
  ]
}
