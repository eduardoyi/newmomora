exports[`book CheckoutScreen output > the first render (the order is being started) 1`] = `"<div class="checkout-screen"><header class="checkout-screen__header"><button type="button" class="checkout-screen__back">← Lía — 2026</button><h1 class="checkout-screen__title">Order this book</h1></header><div class="checkout-screen__body"><p class="checkout-screen__freeze-notice">Your book prints exactly as it looks right now. Edits you make after ordering only affect future orders.</p><p class="checkout-screen__hint">Starting your order…</p></div></div>"`;

exports[`book OrderStatusScreen output > cancelled and refunded 1`] = `"<div class="order-status"><header class="order-status__header"><button type="button" class="order-status__back">← Your book</button><h1 class="order-status__title">Order status</h1><button type="button" class="order-status__all-orders">All orders</button></header><div class="order-status__body"><span class="order-status-chip order-status-chip--neutral">Cancelled</span><p class="order-status__message">This order was cancelled and your payment was refunded.</p><p class="order-status__refunded" role="status">A refund was issued on 10/3/2026.</p><dl class="order-status__facts"><dt>Book</dt><dd>$59.00</dd><dt>Shipping</dt><dd>$12.50</dd><dt>Total</dt><dd>$71.50 (plus tax, if applicable)</dd><dt>Pages</dt><dd>48</dd></dl><div class="order-status__ship-to"><p class="order-status__ship-to-label">Ships to</p><p class="order-status__ship-to-address">Lucía Rivera<br/>1 Example Street<br/>Springfield, IL, 62701<br/>United States</p></div><p class="order-status__contact-hint">Questions about your order? Just reply to your confirmation email or message us at <a href="mailto:hello@usemomora.com">hello@usemomora.com</a>.</p></div></div>"`;

