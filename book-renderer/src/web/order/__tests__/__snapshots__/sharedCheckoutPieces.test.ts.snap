exports[`book rendering through the shared pieces is the original markup > the book address form keeps its markup (state is free text, city optional) 1`] = `"<form class="address-form"><label class="address-field"><span class="address-field__label">Full name</span><input type="text" name="name" autoComplete="shipping name" required="" maxLength="200" class="address-field__input" placeholder="Who&#x27;s this shipping to?" value=""/></label><label class="address-field"><span class="address-field__label">Address line 1</span><input type="text" name="address-line1" autoComplete="shipping address-line1" required="" maxLength="200" class="address-field__input" placeholder="Street address" value=""/></label><label class="address-field"><span class="address-field__label">Address line 2 (optional)</span><input type="text" name="address-line2" autoComplete="shipping address-line2" maxLength="200" class="address-field__input" placeholder="Apartment, suite, etc." value=""/></label><div class="address-form__row"><label class="address-field address-field--grow"><span class="address-field__label">City</span><input type="text" name="city" autoComplete="shipping address-level2" maxLength="200" class="address-field__input" value=""/></label><label class="address-field"><span class="address-field__label">State / region</span><input type="text" name="state" autoComplete="shipping address-level1" maxLength="200" class="address-field__input" value=""/></label></div><div class="address-form__row"><label class="address-field"><span class="address-field__label">Postal code</span><input type="text" name="postal-code" autoComplete="shipping postal-code" required="" maxLength="20" class="address-field__input" value=""/></label><label class="address-field address-field--grow"><span class="address-field__label">Country</span><select name="country" autoComplete="shipping country" required="" class="address-field__input address-field__select"><option value="US" selected="">United States</option><option value="CA">Canada</option><option value="MX">Mexico</option><option value="AU">Australia</option><option value="NZ">New Zealand</option><option value="JP">Japan</option><option value="SG">Singapore</option><option value="CH">Switzerland</option><option value="NO">Norway</option></select></label></div><button type="submit" class="address-form__submit" disabled="">Get quote</button></form>"`;
