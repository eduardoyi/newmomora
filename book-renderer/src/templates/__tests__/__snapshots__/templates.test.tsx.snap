exports[`template snapshots > Dedication renders the child name; the preceding page is a blank page 1`] = `"<div class="page-frame dedication-page" style="aspect-ratio:216 / 216;font-size:0.4629629629629629cqw" data-testid="page-frame" data-spread="false"><div class="page-frame__content"><div class="dedication" style="left:8.333333333333332%;top:29.166666666666668%;width:60.18518518518518%"><div class="dedication__greeting" style="font-size:5.324074074074074cqw;color:#2C2418">For Test Child,</div><div class="dedication__rule" style="background:#CFC8E0"></div><div class="dedication__signature" style="font-size:1.215277777777778cqw;color:#9A8B79">Written with love, day by day</div></div><div style="position:absolute;bottom:6.018518518518518%;right:6.018518518518518%;font-family:var(--font-sans);font-weight:500;font-size:1.143261316872428cqw;letter-spacing:0.07em;color:#9A8B79">1</div></div></div>"`;

exports[`template snapshots > FlexGrid renders the single-memory multi-photo exception with a numbered footer index 1`] = `"<div class="page-frame flex-grid-page" style="aspect-ratio:216 / 216;font-size:0.4629629629629629cqw" data-testid="page-frame" data-spread="false"><div class="page-frame__content"><div class="safe-area" style="position:absolute;top:6.018518518518518%;bottom:6.018518518518518%;left:6.018518518518518%;right:6.018518518518518%"><div class="flex-grid" data-testid="flex-grid"><div class="flex-grid__canvas" style="position:absolute;left:0;right:0;top:0%;height:92.10526315789474%"><div class="flex-grid__cell" style="position:absolute;left:0%;top:0%;width:65.78947368421053%;height:31.428571428571427%"><figure class="photo-tile photo-tile--hero"><div class="photo-tile__frame" style="aspect-ratio:1.5;background:#F2EFF8"><img src="/test-book/assets/asset-1.jpg" alt="" class="photo-tile__img" style="object-fit:cover"/></div><div class="photo-tile__meta"><figcaption class="photo-tile__numeral" style="font-size:0.9309413580246914cqw;color:#C3B8A8">1</figcaption></div></figure></div><div class="flex-grid__cell" style="position:absolute;left:0%;top:34.61538461538461%;width:48.68421052631579%;height:42.857142857142854%"><figure class="photo-tile"><div class="photo-tile__frame" style="aspect-ratio:0.8;background:#F2EFF8"><img src="/test-book/assets/asset-2.jpg" alt="" class="photo-tile__img" style="object-fit:cover"/></div><div class="photo-tile__meta"><figcaption class="photo-tile__numeral" style="font-size:0.9309413580246914cqw;color:#C3B8A8">2</figcaption></div></figure></div><div class="flex-grid__cell" style="position:absolute;left:51.31578947368421%;top:36.53846153846154%;width:48.68421052631579%;height:37.142857142857146%"><figure class="photo-tile"><div class="photo-tile__frame" style="aspect-ratio:1;background:#F2EFF8"><img src="/test-book/assets/asset-3.jpg" alt="" class="photo-tile__img" style="object-fit:cover"/></div><div class="photo-tile__meta"><figcaption class="photo-tile__numeral" style="font-size:0.9309413580246914cqw;color:#C3B8A8">3</figcaption></div></figure></div><div class="flex-grid__cell" style="position:absolute;left:51.31578947368421%;top:75%;width:48.68421052631579%;height:22.857142857142858%"><figure class="photo-tile"><div class="photo-tile__frame" style="aspect-ratio:1.5;background:#F2EFF8"><img src="/test-book/assets/asset-4.jpg" alt="" class="photo-tile__img" style="object-fit:cover"/></div><div class="photo-tile__meta"><figcaption class="photo-tile__numeral" style="font-size:0.9309413580246914cqw;color:#C3B8A8">4</figcaption></div></figure></div></div><div class="footer-index" style="position:absolute;left:0;right:0;bottom:0;display:flex;flex-direction:column;gap:1.0416666666666665%"><div style="height:1px;background:#EBE7F2"></div><div style="display:flex;flex-wrap:wrap;justify-content:flex-end;column-gap:3.4722222222222223%;row-gap:0.9259259259259258%"><div style="display:flex;align-items:baseline;gap:0.4em"><span style="font-family:var(--font-sans);color:#6B5E4F;font-size:1.143261316872428cqw;line-height:1.5"><sup style="font-weight:700;color:#8E7FB8;font-size:0.65em;margin-right:0.15em">1</sup><sup style="font-weight:700;color:#8E7FB8;font-size:0.65em;margin-right:0.15em">2</sup><sup style="font-weight:700;color:#8E7FB8;font-size:0.65em;margin-right:0.15em">3</sup><sup style="font-weight:700;color:#8E7FB8;font-size:0.65em;margin-right:0.35em">4</sup>Jun 1 · Splashing in the pool.</span></div></div></div></div></div><div style="position:absolute;bottom:6.018518518518518%;left:6.018518518518518%;font-family:var(--font-sans);font-weight:500;font-size:1.143261316872428cqw;letter-spacing:0.07em;color:#9A8B79">2</div></div></div>"`;

exports[`template snapshots > IllustratedStory renders text above the illustration 1`] = `"<div class="page-frame illustrated-story-page" style="aspect-ratio:216 / 216;font-size:0.4629629629629629cqw" data-testid="page-frame" data-spread="false"><div class="page-frame__content"><div class="safe-area" style="position:absolute;top:6.018518518518518%;bottom:6.018518518518518%;left:6.018518518518518%;right:6.018518518518518%"><div class="illustrated-story" data-testid="illustrated-story"><div class="illustrated-story__stack" style="top:2.631578947368421%;left:0;width:84.21052631578947%"><div class="illustrated-story__text"><span class="illustrated-story__date" style="font-size:1.099537037037037cqw;color:#C3B8A8">June 1, 2024</span><p class="illustrated-story__body" style="font-size:3.1031378600823043cqw;color:#2C2418">Enzo built a very tall tower.</p></div><div class="illustrated-story__illo" style="margin-top:5%;align-self:flex-end;width:93.45444444444443%;aspect-ratio:1;background:#F2EFF8"><img src="/test-book/assets/illo.webp" alt="" class="illustrated-story__illo-img"/></div></div></div></div><div style="position:absolute;bottom:6.018518518518518%;left:6.018518518518518%;font-family:var(--font-sans);font-weight:500;font-size:1.143261316872428cqw;letter-spacing:0.07em;color:#9A8B79">2</div></div></div>"`;

