{
  "name": "book-renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Memory book layout renderer: parametric templates + deterministic fitter + browser preview, plus a Puppeteer print pipeline (interior + wraparound-cover PDFs) driven by the same templates (see docs/plans/memory-book.md Stage C/E).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "book:pdf": "vite-node scripts/render-pdf.mts",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "tsc --noEmit && vite build --config vite.web.config.ts && npm run check:web-bundle",
    "check:web-bundle": "node scripts/check-web-bundle.mjs"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.9.0",
    "@stripe/stripe-js": "^9.15.0",
    "@supabase/supabase-js": "^2.107.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^24.43.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-node": "^2.1.9",
    "vitest": "^2.1.8"
  }
}
