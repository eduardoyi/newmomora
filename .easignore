# Native app builds only need the Expo project itself. Everything below is
# repo tooling or server-side code that ballooned the EAS upload tarball
# (marketing assets alone are ~1.5 GB) and has no effect on the binary.
marketing/
docs/
cloudflare/
supabase/
.maestro/
__mocks__/
*.md
credentials/
credentials.json

# .easignore replaces .gitignore: explicitly exclude local secrets and output.
.env
.env.*
!.env.example
*.env.local
**/secrets/
*.pem
*.key
*.p8
*.p12
*.jks
*.keystore
*.mobileprovision
service-account*.json
node_modules/
.expo/
.eas/
/ios/
/android/
dist/
coverage/
*.log
book-renderer/book-data/*
!book-renderer/book-data/sample/
!book-renderer/book-data/sample/**
.claude/
