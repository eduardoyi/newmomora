# Momora — environment template
# Copy to .env.local and fill in values. NEVER commit .env.local or real keys.

# --- Client (Expo) — safe to expose in app bundle ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=public_ios_sdk_key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=public_android_sdk_key

# --- NOT in client .env ---
# OPENAI_API_KEY, R2_*, SUPABASE_SERVICE_ROLE_KEY → server-only configuration.
# MEMORY_ILLUSTRATION_BACKEND=legacy|cloudflare and
# PORTRAIT_GENERATION_BACKEND=legacy|cloudflare belong in Supabase function
# secrets/config, never in EXPO_PUBLIC_* or this client file. Cloudflare
# Workflow secrets (OPENAI_API_KEY, memory/portrait bridge HMACs and dispatch
# secrets) belong only in the Worker secret store. See
# docs/cloudflare-illustration-workflows.md.
# AI_USAGE_ALERT_EMAIL is server-only (defaults to hello@usemomora.com); set it in
# Supabase/cron secrets, never as EXPO_PUBLIC_*.
# RevenueCat server configuration is also server-only: REVENUECAT_WEBHOOK_SECRET,
# REVENUECAT_SECRET_API_KEY, and REVENUECAT_PROJECT_ID. Configure the webhook
# endpoint and cron secrets in Supabase Edge Function secrets/Vault; never put
# those values in EXPO_PUBLIC_* variables.
